{
  "name": "space-relics",
  "version": "1.0.0",
  "private": true,
  "description": "Space Relics \u2014 Abandoned but Not Forgotten. Next.js shell + relic API + Launch Lab / Planet Explorer 3D apps.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db.mjs",
    "db:rollback": "node scripts/db.mjs --down",
    "db:status": "node scripts/db.mjs --status",
    "db:export-sqlite": "node scripts/export-sqlite.mjs",
    "db:import": "node scripts/import-missions.mjs",
    "test:sim": "node --test \"Lonch game/launch-lab/test/sim.test.mjs\"",
    "test:db": "node --test test/db.test.mjs test/migration.test.mjs",
    "test:http": "node --test test/http.test.mjs",
    "test:rate-limit": "node --test test/rate-limit.test.mjs",
    "test:all": "npm run test:sim && npm run test:db && npm run test:http && npm run test:rate-limit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.2.1",
    "@react-three/fiber": "^9.8.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
